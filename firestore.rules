rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'damtanthanh23@gmail.com' ||
        request.auth.token.email == 'admin@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'co_teacher'])
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Exam Tests collection
    match /tests/{testId} {
      // Public read access so students can take tests without sign-in barrier
      allow read: if true;

      // Teachers/Admins (signed-in or PIN-unlocked) can create and update valid exam documents
      allow create, update: if isValidId(testId)
        && request.resource.data.id == testId
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 300;

      allow delete: if isSignedIn()
        && (isAdmin() || !('creatorId' in resource.data) || resource.data.creatorId == request.auth.uid);
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if (isOwner(userId)
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId)) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // Exam attempts history (read allowed for authenticated learners for the shared leaderboard)
      match /attempts/{attemptId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) || isAdmin();
      }

      // In-progress exam & practice state (auto-save, pause timers, answers)
      match /inProgress/{testId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) || isAdmin();
      }

      // Vocabulary Spaced Repetition (Anki SM-2 & Quizlet progress)
      match /vocabSrs/{docId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) || isAdmin();
      }

      // User personal vocab decks
      match /vocab_decks/{deckId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) || isAdmin();
      }

      // User vocab partition state
      match /vocab_state/{stateId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // Official & Global VSTEP B1 Vocabulary Topics & Decks
    match /vocab_b1_topics/{topicId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Global settings (e.g., deleted_tests list, exam_tags, and b1_vocab_database metadata)
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || docId == 'exam_tags' || docId == 'deleted_tests' || docId == 'b1_vocab_database';
    }

    // Persistent Audio Chunks for Custom Exam MP3s
    match /test_audio_chunks/{chunkId} {
      allow read: if true;
      allow create, update, delete: if isValidId(chunkId);
    }

    // Student Bug Reports & Suggestions
    match /feedbacks/{feedbackId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(feedbackId)
        && request.resource.data.keys().hasAll(['id', 'userName', 'category', 'message', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.id == feedbackId
        && request.resource.data.userName is string
        && request.resource.data.userName.size() >= 1
        && request.resource.data.userName.size() <= 150
        && request.resource.data.category in ['question_error', 'audio_media', 'answer_explanation', 'ui_issue', 'general_suggestion']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 2
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == 'unread'
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;

      allow update: if isAdmin()
        && request.resource.data.status in ['unread', 'read', 'unresolved', 'resolved']
        && request.resource.data.updatedAt is number;

      allow delete: if isAdmin();
    }
  }
}
